# =============================================
# Cross-Modal Intelligence Platform — Backend
# Environment Variables Template
# =============================================

# Flask
FLASK_ENV=development
SECRET_KEY=your-very-secret-key-change-in-production
DEBUG=True

# Demo Mode (set to true to run without MongoDB for college demo / presentation)
DEMO_MODE=true

# MongoDB (required only when DEMO_MODE=false)
MONGO_URI=mongodb://localhost:27017/crossmodal_db
# For MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/crossmodal_db

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=86400

# Frontend URL (for CORS — set to your Vercel domain in production)
FRONTEND_URL=http://localhost:5173

# File Upload
MAX_CONTENT_LENGTH=10485760
UPLOAD_FOLDER=uploads

# Rate Limiting
RATELIMIT_DEFAULT=100 per hour
