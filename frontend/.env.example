# Frontend Environment Template
# Leave VITE_API_URL empty in local Vite dev to use the /api proxy to localhost:5000.
# For Vercel production, set VITE_API_URL to your deployed Render backend URL, e.g.:
# VITE_API_URL=https://cybernex-api.onrender.com
VITE_API_URL=

# Set to true to enable frontend Demo Mode notice & offline sample fallback
VITE_DEMO_MODE=true
